# ============================================================
# MediaHub 全栈环境变量配置
# 复制为 .env 后填入实际值
# ============================================================

# ---------- 数据库 ----------
POSTGRES_USER=mediahub
POSTGRES_PASSWORD=changeme_strong_pass
POSTGRES_DB=mediahub
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=changeme_redis_pass
REDIS_PORT=6379

# ---------- MediaHub API ----------
API_PORT=3000
API_MODE=debug                       # debug | release
API_JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long
API_LOG_LEVEL=info                   # debug | info | warn | error

# ---------- MediaHub Admin (CMS) ----------
ADMIN_PORT=8080

# ---------- MediaHub Web Player ----------
WEB_PORT=8081

# ---------- TMDB API ----------
# 在 https://www.themoviedb.org/settings/api 申请免费 key
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_LANGUAGE=zh-CN                  # 中文元数据
TMDB_BASE_URL=https://api.themoviedb.org/3
# 国内访问超时时可改用官方镜像域：
# TMDB_BASE_URL=https://api.tmdb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_TIMEOUT=45
# 若 NAS 走 Clash 等代理，填入代理地址（api 容器内生效）：
# HTTP_PROXY=http://192.168.3.1:7890
# HTTPS_PROXY=http://192.168.3.1:7890
# NO_PROXY=postgres,redis,qbittorrent,localhost,127.0.0.1

# ---------- 媒资存储路径 (容器内) ----------
MEDIA_ROOT=/media
DOWNLOAD_ROOT=/downloads

# ---------- NAS 挂载点 (宿主机实际路径) ----------
# DS920+ 示例（按你的实际修改）
NAS_MEDIA_HOST=/volume1/media
NAS_DOWNLOADS_HOST=/volume1/downloads

# ---------- qBittorrent ----------
# QBIT_PASSWORD 会由 scripts/qbit-init-password.sh 在容器启动时自动写入 qBit 配置，
# API 容器也使用同一密码连接 qBittorrent（修改后需 docker compose restart qbittorrent api）
QBIT_HOST=qbittorrent
QBIT_PORT=8080
QBIT_USER=admin
QBIT_PASSWORD=changeme_qbit_pass

# ---------- 索引搜索（Prowlarr，CMS 在线找资源入库） ----------
# INDEXER_URL 填 Prowlarr 根地址，如 http://192.168.3.120:9696
# INDEXER_API_KEY 在 Prowlarr → Settings → General → API Key
# INDEXER_URL=
# INDEXER_API_KEY=

# ---------- 转码配置 ----------
TRANSCODE_ENABLED=true
TRANSCODE_HW_ACCEL=qsv               # qsv (Intel Quick Sync) | nvenc | none
TRANSCODE_PREFER_COPY=true           # 内网 4K：HLS 流复制（不重编码），MKV HEVC 保持原画质
TRANSCODE_MAX_BITRATE=2500k          # 需转码时的输出码率（流复制时忽略）
TRANSCODE_MAX_HEIGHT=480             # 需转码时的最大高度；0=源分辨率
TRANSCODE_PRESET=ultrafast           # 软转 preset：ultrafast | fast | medium
TRANSCODE_SEGMENT_TIME=4             # HLS 切片时长（秒）

# ---------- HLS 转码缓存（容器内路径 + NAS 挂载） ----------
HLS_CACHE_ROOT=/data/hls-cache
HLS_CACHE_HOST=/volume1/docker/mediahub/hls-cache

# ---------- 刮削配置 ----------
SCRAPER_WORKER_COUNT=3
SCRAPER_RETRY_TIMES=3

# ---------- 直播推流（MediaMTX） ----------
LIVE_ENABLED=true
# OBS 推流地址：rtmp://<NAS_IP>:1935/<stream_key>
# stream_key 在 CMS 创建直播间后显示
LIVE_RTMP_HOST=localhost:1935
LIVE_RTMP_PORT=1935
LIVE_HLS_PORT=8888
# API 容器内访问 MediaMTX HLS 的地址（一般不用改）
LIVE_MEDIAMTX_URL=http://mediamtx:8888
