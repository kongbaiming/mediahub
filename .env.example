# ============================================================
# MediaHub 全栈环境变量配置
# 复制为 .env 后填入实际值
# ============================================================

# ---------- 数据库 ----------
POSTGRES_USER=mediahub
POSTGRES_PASSWORD=changeme_strong_pass
POSTGRES_DB=mediahub
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=changeme_redis_pass
REDIS_PORT=6379

# ---------- MediaHub API ----------
API_PORT=3000
API_MODE=debug                       # debug | release
API_JWT_SECRET=changeme_jwt_secret_at_least_32_chars_long
API_LOG_LEVEL=info                   # debug | info | warn | error

# ---------- MediaHub Admin (CMS) ----------
ADMIN_PORT=8080

# ---------- MediaHub Web Player ----------
WEB_PORT=8081

# ---------- TMDB API ----------
# 在 https://www.themoviedb.org/settings/api 申请免费 key
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_LANGUAGE=zh-CN                  # 中文元数据
TMDB_BASE_URL=https://api.themoviedb.org/3

# ---------- 媒资存储路径 (容器内) ----------
MEDIA_ROOT=/media
DOWNLOAD_ROOT=/downloads

# ---------- NAS 挂载点 (宿主机实际路径) ----------
# DS920+ 示例（按你的实际修改）
NAS_MEDIA_HOST=/volume1/media
NAS_DOWNLOADS_HOST=/volume1/downloads

# ---------- qBittorrent ----------
QBIT_HOST=qbittorrent
QBIT_PORT=8080
QBIT_USER=admin
QBIT_PASSWORD=changeme_qbit_pass

# ---------- 转码配置 ----------
TRANSCODE_ENABLED=true
TRANSCODE_HW_ACCEL=qsv               # qsv (Intel Quick Sync) | nvenc | none
TRANSCODE_MAX_BITRATE=8000k

# ---------- 刮削配置 ----------
SCRAPER_WORKER_COUNT=3
SCRAPER_RETRY_TIMES=3
