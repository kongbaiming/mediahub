# MediaHub .env 模板（占位版）
# 复制这段内容到 NAS 上，保存为 /volume1/progect/mediahub/.env（或你的实际路径）

POSTGRES_USER=mediahub
POSTGRES_PASSWORD=changeme_postgres_pass
POSTGRES_DB=mediahub
POSTGRES_PORT=5432

REDIS_PASSWORD=changeme_redis_pass
REDIS_PORT=6379

API_PORT=3000
API_MODE=debug
API_JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long_xxx
API_LOG_LEVEL=info

ADMIN_PORT=8080
WEB_PORT=8081

TMDB_API_KEY=changeme_your_tmdb_v3_api_key
TMDB_LANGUAGE=zh-CN
TMDB_BASE_URL=https://api.themoviedb.org/3

MEDIA_ROOT=/media
DOWNLOAD_ROOT=/downloads

NAS_MEDIA_HOST=/volume1/media
NAS_DOWNLOADS_HOST=/volume1/downloads

# QBIT_PASSWORD 会在 qbittorrent 容器启动时自动写入 conf（见 scripts/qbit-init-password.sh）
QBIT_HOST=qbittorrent
QBIT_PORT=8080
QBIT_USER=admin
QBIT_PASSWORD=changeme_qbit_pass

TRANSCODE_ENABLED=true
TRANSCODE_HW_ACCEL=qsv
TRANSCODE_MAX_BITRATE=8000k

SCRAPER_WORKER_COUNT=3
SCRAPER_RETRY_TIMES=3