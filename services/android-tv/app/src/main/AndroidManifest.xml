<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- TV 必需：触屏可选（遥控器是主交互） -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground Service（后台播放） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Android 13+ 媒体权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MediaHubApp"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:logo="@drawable/tv_banner"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaHub"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        tools:targetApi="31">

        <!-- Leanback 主入口（带 launcher 图标） -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MediaHub.Leanback">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 首次配置 Activity（输入 NAS API 地址） -->
        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MediaHub.Leanback" />

        <!-- 播放 Activity（独立的全屏播放 UI） -->
        <activity
            android:name=".ui.playback.PlaybackActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MediaHub.Playback" />

        <!-- 搜索 Activity -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MediaHub.Leanback" />

        <!-- 设置 Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MediaHub.Leanback" />

        <!-- 详情 Activity（Compose Screen 在 MainActivity 内可，这里注册为可选独立 Activity） -->
        <activity
            android:name=".ui.detail.DetailActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MediaHub.Leanback" />

        <!-- 媒体会话（系统媒体控件集成） -->
        <service
            android:name=".playback.MediaSessionService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

    </application>
</manifest>
